# Frontend (safe to expose in the browser)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Older local stacks may only provide an anon key; the client accepts either.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Local tooling only. NEVER prefix the service role key with VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional local demo password used by `npm run seed:auth` (default: MessMate@123).
# DEMO_AUTH_PASSWORD=MessMate@123

# Optional Google OAuth credentials for the local Supabase stack.
# Also set [auth.external.google].enabled = true in supabase/config.toml.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Used by `npm run provision:admin` (the first administrator must be provisioned
# before that email can sign in successfully).
# ADMIN_EMAIL=admin@iiita.ac.in
# ADMIN_NAME=Mess Administrator
